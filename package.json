{
  "name": "dmk-ui",
  "version": "0.1.0",
  "description": "场景化 Vue3 组件库：面向后台管理 / 门户网站 / AI 产品的基础组件层。语义令牌驱动主题与暗黑模式，四态统一（空/加载/错误/边界），零运行时依赖（仅 vue peer）。",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "vue3",
    "component-library",
    "ui",
    "admin",
    "design-tokens",
    "dark-mode",
    "typescript",
    "组件库",
    "后台管理",
    "主题"
  ],
  "main": "./dist/index.umd.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.umd.cjs"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "vite build && vue-tsc -p tsconfig.build.json",
    "check": "vue-tsc --noEmit"
  },
  "peerDependencies": {
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.1.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vue": "^3.5.12",
    "vue-tsc": "^2.1.10"
  }
}

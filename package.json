{
  "name": "dmk-ui-vue",
  "version": "0.2.0",
  "description": "场景化 Vue3 组件库：面向后台管理 / 门户网站 / AI 产品的基础组件层，对标 Element Plus 全部 82 个组件。语义令牌驱动主题与暗黑模式，五风格 × 明暗 × 密度正交矩阵，四态统一（空/加载/错误/边界），零运行时依赖（仅 vue peer）。",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "vue3",
    "component-library",
    "ui",
    "admin",
    "design-tokens",
    "dark-mode",
    "typescript",
    "element-plus",
    "组件库",
    "后台管理",
    "主题",
    "element"
  ],
  "main": "./dist/index.umd.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.umd.cjs"
    },
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "vite build && node node_modules/vue-tsc/bin/vue-tsc.js -p tsconfig.build.json",
    "check": "node node_modules/vue-tsc/bin/vue-tsc.js --noEmit",
    "test": "node scripts/verify-package.mjs",
    "prepublishOnly": "npm run build && node scripts/verify-package.mjs"
  },
  "peerDependencies": {
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.1.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vue": "^3.5.12",
    "vue-tsc": "^2.1.10"
  },
  "author": {
    "name": "DuanMK"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DW-WJ/dmk-ui.git"
  },
  "homepage": "https://github.com/DW-WJ/dmk-ui#readme",
  "bugs": {
    "url": "https://github.com/DW-WJ/dmk-ui/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
}
